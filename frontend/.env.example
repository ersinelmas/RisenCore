# --- Environment variables for local frontend development ---
# Copy this file to .env and fill in your own values.
# The .env file is ignored by Git.

# Base URL the frontend uses to reach the backend API.
# When running the backend via Docker Compose (dev profile) on the default port:
VITE_API_BASE_URL=http://localhost:8080/api

# For a production build, set this to your deployed backend's URL, e.g.:
# VITE_API_BASE_URL=https://api.risencore.example.com/api
# It must match an origin that's allowed to call the API, i.e. the backend's
# SecurityConfig CORS allow-list (currently https://risencore.vercel.app for the frontend
# itself calling the backend — VITE_API_BASE_URL is the backend's own URL, not the frontend's).
